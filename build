#!/usr/bin/env bash

set -eo pipefail
shopt -s dotglob nullglob
trap 'echo "${0} line ${LINENO} Status: ${?}"' ERR

git clone https://github.com/ggml-org/whisper.cpp || echo "Using existing checkout."
cd whisper.cpp
cmake -B build \
  -DCMAKE_BUILD_TYPE=Release \
  -DGGML_VULKAN=1 \
  -DGGML_NATIVE=ON
cmake --build build -j 8 --target whisper parakeet
cd ..

# The libraries live in the build tree, so the uninstalled binary needs an rpath
# to find them. The packaged build installs them into /usr/lib instead.
export CGO_LDFLAGS="-Wl,-rpath,$PWD/whisper.cpp/build/bin"
go install
whispy -print-text -keep-audio
